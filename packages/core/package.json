{
  "name": "@cuub/core",
  "version": "1.0.0",
  "description": "Shared CUUB domain logic for the app and the website: station model, geo and camera math, map GeoJSON, API client, links, analytics.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./geo": "./src/geo/index.ts",
    "./map": "./src/map/index.ts",
    "./stations": "./src/stations/index.ts",
    "./nearest": "./src/nearest/index.ts",
    "./api": "./src/api/index.ts",
    "./directions": "./src/directions/index.ts",
    "./links": "./src/links/index.ts",
    "./analytics": "./src/analytics/index.ts"
  },
  "private": true,
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3"
  }
}
