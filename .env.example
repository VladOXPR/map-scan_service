# Copy to .env for local dev. Set the same variable in Cloud Run.
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_token_here

# Optional: mirror scan POSTs to cuub-api (used by Next apps/web and legacy server.js).
# CUUB_API_MIRROR_ENABLED=true
# CUUB_API_URL=https://<cuub-api-cloud-run-url>
# CUUB_API_TOKEN=<same value as cuub-api MACHINE_API_TOKEN>
