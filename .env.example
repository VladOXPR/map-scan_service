# Copy to .env for local dev. Set the same variables in Cloud Run (map-scan-service).
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_token_here

# cuub-api — battery scans + live station slots (Energo via cuub-api)
CUUB_API_URL=http://localhost:3001
CUUB_API_TOKEN=<same value as cuub-api MACHINE_API_TOKEN>
# Live slots need CUUB_API_TOKEN; without it /api/stations falls back to public GET /map.
