MAPBOX_ACCESS_TOKEN=pk.your_mapbox_token_here
CUUB_API_BASE=https://api.cuub.tech
CUUB_SUPPORT_PHONE=+14642377449

# Optional: mirror scan POSTs to cuub-api (site_visits) for the dashboard Batteries page.
# Legacy CUUB_API_BASE remains primary; mirror failures are logged only.
CUUB_API_MIRROR_ENABLED=true
CUUB_API_URL=http://localhost:3001
CUUB_API_TOKEN=<same value as cuub-api MACHINE_API_TOKEN>

# Cloud Run (map-scan-service cannot reach localhost):
# CUUB_API_URL=https://<cuub-api-cloud-run-url>
# CUUB_API_TOKEN=<machine-api-token secret>
