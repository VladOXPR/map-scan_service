MAPBOX_ACCESS_TOKEN=pk.your_mapbox_token_here
CUUB_SUPPORT_PHONE=+14642377449

# cuub-api — battery scans + live station slots (Energo via cuub-api, same as dashboard)
CUUB_API_URL=http://localhost:3001
CUUB_API_TOKEN=<same value as cuub-api MACHINE_API_TOKEN>

# /api/stations prefers GET /stations?include_live=true (needs CUUB_API_TOKEN).
# If that call fails, it falls back to public GET /map (pins only, no slot counts).

# /crawl free power bank page; defaults to "crawl" when unset.
CRAWL_PASSWORD=crawl
# Second /crawl password with no 1-hour per-device cooldown; defaults to "vladsucks".
CRAWL_UNLIMITED_PASSWORD=vladsucks

# Cloud Run production:
# CUUB_API_URL=https://cuub-api-b6xf65lbpq-uc.a.run.app
# CUUB_API_TOKEN=<machine-api-token secret from Secret Manager>
