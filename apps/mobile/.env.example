EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token_here
# Consumer / platform API (map + app auth). Not api.cuub.tech (Energo token extractor).
EXPO_PUBLIC_CUUB_API_URL=https://platform.cuub.tech
# App Store / legal pages (https). Override if hosted elsewhere.
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://cuub.tech/privacypolicy
EXPO_PUBLIC_SUPPORT_URL=https://cuub.tech/contact
EXPO_PUBLIC_TERMS_URL=https://cuub.tech/termsandconditions
# Stripe publishable key (pk_test_ in sandbox; Google Pay runs in test mode with a pk_test_ key).
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
# Page Apple Pay shows for managing the recurring membership.
EXPO_PUBLIC_MEMBERSHIP_MANAGE_URL=https://cuub.tech/contact
# Hosts whose /s/<code> station links the app opens (first one is used for shared links).
EXPO_PUBLIC_LINK_HOSTS=go.cuub.tech
# PostHog product analytics (project API key is public by design).
EXPO_PUBLIC_POSTHOG_KEY=phc_your_project_key
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Do NOT put MACHINE_API_TOKEN, STRIPE_SECRET_KEY or any operator secret in the app.
